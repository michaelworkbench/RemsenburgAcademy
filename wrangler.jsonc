// Cloudflare Workers configuration for the Remsenburg Academy site.
//
// Build first (npm run build), then deploy with `npx wrangler deploy`.
// The worker entry and static assets come out of the nitro build in .output/.
//
// PRODUCTION: this targets the Academy's own Cloudflare account (cut over
// 2026-11-23). Deploying needs an API token for that account in
// CLOUDFLARE_API_TOKEN — a wrangler OAuth login for a different account
// will fail loudly on the account_id mismatch, which is intentional.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remsenburg-academy",
  "account_id": "4540d3033eabe2d8449b86b7469bf14d",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remsenburg-academy",
      "database_id": "e08f8d20-ff41-44c1-a28d-8eb1a8c84394"
    }
  ],
  // Poster image uploads. PAUSED until the Academy's own Cloudflare account
  // exists with R2 enabled — then create the bucket and uncomment:
  // "r2_buckets": [
  //   { "binding": "IMAGES", "bucket_name": "remsenburg-academy-images" }
  // ],
  "observability": { "enabled": true }
}
